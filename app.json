{
  "expo": {
    "name": "TNViewer",
    "slug": "tnviewer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tnviewer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "info.trafficnetwork.tnviewer",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "package": "info.trafficnetwork.tnviewer",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TNViewer nutzt deinen Standort, um Meldungen in deiner Nähe anzuzeigen und Meldungen an deiner Position abzusetzen. Im Fahrmodus wird er auch bei ausgeschaltetem Bildschirm genutzt, solange der Fahrmodus läuft, um dich vor Meldungen voraus zu warnen. / TNViewer uses your location to show reports near you and to place reports at your position. In the drive mode it is also used with the screen off, only while the drive mode is running, to warn you about reports ahead.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "./plugins/with-only-needed-background-modes.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f5ea996-3ae2-4418-9fdc-7b85c9ecb1c3"
      }
    },
    "owner": "reamcrbss-team",
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
